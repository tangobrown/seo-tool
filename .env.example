# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Public base URL of the app (used in Slack links, PR bodies and workflow callbacks).
APP_URL=http://localhost:3000
# Neon pooled connection string (runtime). Any Postgres works locally.
DATABASE_URL=postgres://seo:seo@localhost:5432/seo
# Neon direct (unpooled) connection string, used for migrations.
DATABASE_URL_UNPOOLED=postgres://seo:seo@localhost:5432/seo

# 32+ random characters for the encrypted session cookie: openssl rand -base64 48
SESSION_SECRET=
# The one operator login.
ADMIN_EMAIL=
# Set ONE of these. ADMIN_PASSWORD is the simple option: a long password used nowhere else.
ADMIN_PASSWORD=
# Or an argon2id hash from `pnpm hash-password` (takes priority if both are set). In a local .env every $ must be
# escaped as \$ (Next.js expands $VARS); on Vercel paste the hash unescaped.
ADMIN_PASSWORD_HASH=
# 32 bytes, base64, for AES-256-GCM (OAuth tokens, Slack webhook URL): openssl rand -base64 32
ENCRYPTION_KEY=

# Inngest (set automatically by the Vercel integration). Locally, run `pnpm inngest` and set INNGEST_DEV=1.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=1
# Set EXECUTION_MODE=fake to simulate execution (local dev/demos). Unset = real Claude Code runs via GitHub Actions.
# EXECUTION_MODE=fake
# FakeExecutor speed multiplier (0.3 = ~3x faster).
# FAKE_EXECUTOR_SPEED=1

# Anthropic API: page classification, discovery, recommendation text, reports, drafts.
# Optional: you can paste it in Settings → Integrations instead (stored encrypted; needs ENCRYPTION_KEY).
ANTHROPIC_API_KEY=
# Model for all LLM calls. Defaults to claude-opus-5-5 when unset.
ANTHROPIC_MODEL=claude-opus-5-5

# SiteGuru API key (MCP, Bearer). Optional: paste it in Settings → Integrations instead. See docs/integrations/siteguru.md.
SITEGURU_API_KEY=

# GitHub App (Phase 2): App ID, slug (for the install link), private key (PEM; \n-escaped is fine), webhook secret.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# HMAC secret for Claude Code workflow callbacks. Same value as the org Actions secret SEO_AUTOPILOT_CALLBACK_SECRET.
GITHUB_CALLBACK_SECRET=

# Google OAuth client for Business Profile (Phase 6).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DataForSEO credentials for SERP tracking (Phase 7).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
